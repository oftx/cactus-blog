---
import { render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { Icon } from "astro-icon/components";
import PostPreview from "@/components/blog/PostPreview.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllPosts, getTagMeta, getUniqueTags } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort, getFormattedDate } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
	const allPosts = await getAllPosts();
	const sortedPosts = allPosts.sort(collectionDateSort);
	const uniqueTags = getUniqueTags(sortedPosts);

	return uniqueTags.flatMap((tag) => {
		const postsWithTag = sortedPosts.filter((post) => post.data.tags.includes(tag));
		return paginate(postsWithTag, {
			pageSize: 10,
			params: { tag },
		});
	});
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const { tag } = Astro.params;
const tagMeta = await getTagMeta(tag);

const TagContent = tagMeta ? (await render(tagMeta)).Content : null;

const meta = {
	description: tagMeta?.data.description ?? `查看标签带有 #${tag} 的所有文章`,
	title: `标签：#${tag}`,
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			text: "← 上一页",
			url: page.url.prev,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			text: "下一页 →",
			url: page.url.next,
		},
	}),
};
---

<PageLayout meta={meta}>
	<nav aria-label="Breadcrumb" class="mb-8">
		<ul class="text-muted flex items-center gap-x-2">
			<li>
				<a class="cactus-link inline-block" href="/">首页</a>
			</li>
			<li class="inline-block">
				<Icon aria-hidden="true" class="h-4 w-4" name="tabler:chevron-right" />
			</li>
			<li>
				<a class="cactus-link inline-block" href="/tags/">标签</a>
			</li>
			<li class="inline-block">
				<Icon aria-hidden="true" class="h-4 w-4" name="tabler:chevron-right" />
			</li>
			<li aria-current="page" class=""><span aria-hidden="true">#</span>{tag}</li>
		</ul>
	</nav>
	<h1 class="title">{tagMeta?.data.title ?? `标签：#${tag}`}</h1>
	<div class="prose prose-sm prose-cactus mb-16 max-w-none">
		{tagMeta?.data.description && <p>{tagMeta.data.description}</p>}
		{TagContent && <TagContent />}
	</div>
	<ul class="space-y-4">
		{
			page.data.map((p, index, posts) => {
				const curDate = getFormattedDate(p.data.publishDate);
				const prevDate = index > 0 ? getFormattedDate(posts[index - 1]?.data.publishDate) : null;
				const hideDate = curDate === prevDate;
				return (
					<li
						class="group grid gap-1 sm:grid-cols-[auto_1fr]"
						data-date-group={curDate}
						data-hide-default={hideDate ? "true" : undefined}
					>
						<PostPreview as="h2" post={p} />
					</li>
				);
			})
		}
	</ul>
	<Pagination {...paginationProps} />
</PageLayout>

<script is:inline>
	(() => {
		const handleEnter = (e) => {
			const target = e.target;
			if (!target || !(target instanceof Element)) return;
			const li = target.closest("li[data-date-group]");
			if (!li || !(li instanceof HTMLElement)) return;
			const date = li.dataset.dateGroup;
			if (!date) return;
			const siblings = document.querySelectorAll(`li[data-date-group="${date}"]`);
			if (siblings.length <= 1) return;

			siblings.forEach((item) => {
				if (item instanceof HTMLElement) {
					item.dataset.groupHover = "true";
					if (item === li) {
						item.dataset.activeRow = "true";
					} else {
						delete item.dataset.activeRow;
					}
				}
			});
		};

		const handleLeave = (e) => {
			const target = e.target;
			if (!target || !(target instanceof Element)) return;
			const li = target.closest("li[data-date-group]");
			if (!li || !(li instanceof HTMLElement)) return;
			const date = li.dataset.dateGroup;
			if (!date) return;

			const related = e.relatedTarget;
			if (related && related instanceof Element) {
				const relatedLi = related.closest(`li[data-date-group="${date}"]`);
				if (relatedLi) return;
			}

			const siblings = document.querySelectorAll(`li[data-date-group="${date}"]`);
			siblings.forEach((item) => {
				if (item instanceof HTMLElement) {
					delete item.dataset.groupHover;
					delete item.dataset.activeRow;
				}
			});
		};

		document.addEventListener("mouseover", handleEnter);
		document.addEventListener("focusin", handleEnter);
		document.addEventListener("mouseout", handleLeave);
		document.addEventListener("focusout", handleLeave);
	})();
</script>
