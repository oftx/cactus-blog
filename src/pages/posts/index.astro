---
import PostPreview from "@/components/blog/PostPreview.astro";
import { getAllPosts, groupPostsByYear } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort, getFormattedDate } from "@/utils/date";

const MAX_PINNED_POSTS = 3;
const allPosts = await getAllPosts();
const allPostsByDate = allPosts.sort(collectionDateSort);
const pinnedPosts = allPostsByDate
	.values()
	.filter((p) => p.data.pinned)
	.take(MAX_PINNED_POSTS)
	.toArray();

const meta = {
	description: "所有发布的文章与记录",
	title: "文章",
};

const groupedByYear = groupPostsByYear(allPostsByDate);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">文章</h1>
	<div>
		{
			pinnedPosts.length > 0 && (
				<section class="mb-16">
					<h2 class="title mb-6 text-xl">置顶文章</h2>
					<ul class="space-y-4" role="list">
						{pinnedPosts.map((p) => (
							<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
								<PostPreview post={p} />
							</li>
						))}
					</ul>
				</section>
			)
		}
		{
			descYearKeys.map((yearKey) => (
				<section class="mb-12">
					<h2 id={`year-${yearKey}`} class="title text-lg">
						<span class="sr-only">年份：</span>
						{yearKey}
					</h2>
					<ul class="mt-5 space-y-4 text-start">
						{groupedByYear[yearKey]?.map((p, index, posts) => {
							const curDate = getFormattedDate(p.data.publishDate);
							const prevDate =
								index > 0 ? getFormattedDate(posts[index - 1]?.data.publishDate) : null;
							const hideDate = curDate === prevDate;
							return (
								<li
									class="group grid gap-1 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2"
									data-date-group={curDate}
									data-hide-default={hideDate ? "true" : undefined}
								>
									<PostPreview post={p} />
								</li>
							);
						})}
					</ul>
				</section>
			))
		}
	</div>
</PageLayout>

<script is:inline>
	(() => {
		const handleEnter = (e) => {
			const target = e.target;
			if (!target || !(target instanceof Element)) return;
			const li = target.closest("li[data-date-group]");
			if (!li || !(li instanceof HTMLElement)) return;
			const date = li.dataset.dateGroup;
			if (!date) return;
			const siblings = document.querySelectorAll(`li[data-date-group="${date}"]`);
			if (siblings.length <= 1) return;

			siblings.forEach((item) => {
				if (item instanceof HTMLElement) {
					item.dataset.groupHover = "true";
					if (item === li) {
						item.dataset.activeRow = "true";
					} else {
						delete item.dataset.activeRow;
					}
				}
			});
		};

		const handleLeave = (e) => {
			const target = e.target;
			if (!target || !(target instanceof Element)) return;
			const li = target.closest("li[data-date-group]");
			if (!li || !(li instanceof HTMLElement)) return;
			const date = li.dataset.dateGroup;
			if (!date) return;

			const related = e.relatedTarget;
			if (related && related instanceof Element) {
				const relatedLi = related.closest(`li[data-date-group="${date}"]`);
				if (relatedLi) return;
			}

			const siblings = document.querySelectorAll(`li[data-date-group="${date}"]`);
			siblings.forEach((item) => {
				if (item instanceof HTMLElement) {
					delete item.dataset.groupHover;
					delete item.dataset.activeRow;
				}
			});
		};

		document.addEventListener("mouseover", handleEnter);
		document.addEventListener("focusin", handleEnter);
		document.addEventListener("mouseout", handleLeave);
		document.addEventListener("focusout", handleLeave);
	})();
</script>
