---
import { siteConfig } from "@/site.config";

const year = new Date().getFullYear();
---

<footer
	class="text-muted group mt-auto flex w-full flex-col items-center justify-center gap-y-1.5 pt-20 pb-6 text-center text-xs font-semibold"
>
	<div class="opacity-0 group-hover:opacity-60">
		<a class="hover:text-global-text underline underline-offset-2" href="/rss.xml" target="_blank">
			RSS
		</a>&nbsp;/&nbsp;<a
			class="hover:text-global-text underline underline-offset-2"
			href="/sitemap-index.xml"
			target="_blank"
		>
			Sitemap
		</a>
	</div>
	<div class="opacity-0 group-hover:opacity-60">
		<a
			class="hover:text-global-text underline underline-offset-2"
			href="https://icp.gov.moe/?keyword=20257555"
			rel="noreferrer"
			target="_blank"
		>
			萌ICP备20257555号
		</a>
	</div>
	<div class="opacity-60">
		&copy;&nbsp;{year}&nbsp;{siteConfig.author}. All Rights Reserved.
	</div>
</footer>
