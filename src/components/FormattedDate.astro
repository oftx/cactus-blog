---
import type { HTMLAttributes } from "astro/types";
import { getFormattedDate } from "@/utils/date";

type Props = HTMLAttributes<"time"> & {
	date: Date;
	dateTimeOptions?: Intl.DateTimeFormatOptions;
	includeTime?: boolean;
};

const { date, dateTimeOptions, includeTime = false, ...attrs } = Astro.props;

const ISO = date.toISOString();

// Initial format at build time
let postDate = getFormattedDate(date, dateTimeOptions);
if (includeTime) {
	const pad = (n: number) => String(n).padStart(2, "0");
	const year = date.getFullYear();
	const month = pad(date.getMonth() + 1);
	const day = pad(date.getDate());
	const hours = pad(date.getHours());
	const minutes = pad(date.getMinutes());
	const seconds = pad(date.getSeconds());
	postDate = `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
}
---

<time datetime={ISO} title={ISO} data-include-time={includeTime ? "true" : undefined} {...attrs}
	>{postDate}</time
>

<script is:inline>
	(() => {
		const formatDates = () => {
			const pad = (n) => String(n).padStart(2, "0");
			document.querySelectorAll("time[datetime]").forEach((el) => {
				const dt = el.getAttribute("datetime");
				if (!dt) return;
				const d = new Date(dt);
				if (isNaN(d.getTime())) return;
				const Y = d.getFullYear();
				const M = pad(d.getMonth() + 1);
				const D = pad(d.getDate());
				const dateStr = `${Y}-${M}-${D}`;
				if (el.getAttribute("data-include-time") === "true") {
					const h = pad(d.getHours());
					const m = pad(d.getMinutes());
					const s = pad(d.getSeconds());
					el.textContent = `${dateStr} ${h}:${m}:${s}`;
				} else {
					el.textContent = dateStr;
				}
				const li = el.closest("li[data-date-group]");
				if (li) {
					li.dataset.dateGroup = dateStr;
				}
			});

			document.querySelectorAll("ul").forEach((ul) => {
				const items = ul.querySelectorAll("li[data-date-group]");
				if (!items.length) return;
				items.forEach((item, idx) => {
					const cur = item.dataset.dateGroup;
					const prev = idx > 0 ? items[idx - 1].dataset.dateGroup : null;
					if (cur && cur === prev) {
						item.dataset.hideDefault = "true";
					} else {
						delete item.dataset.hideDefault;
					}
				});
			});
		};

		formatDates();
		document.addEventListener("astro:page-load", formatDates);
		window.addEventListener("pageshow", formatDates);
	})();
</script>
