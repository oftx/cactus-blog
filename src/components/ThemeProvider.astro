<script is:inline>
	const darkMedia = window.matchMedia("(prefers-color-scheme: dark)");

	function getSystemTheme() {
		return darkMedia.matches ? "dark" : "light";
	}

	function getUserPref() {
		const sessionOverride =
			typeof sessionStorage !== "undefined" && sessionStorage.getItem("theme-override");
		if (sessionOverride === "dark" || sessionOverride === "light") {
			return sessionOverride;
		}
		return getSystemTheme();
	}

	function applyTheme(newTheme, animate = false) {
		const root = document.documentElement;
		if (newTheme === root.getAttribute("data-theme")) {
			return;
		}

		const update = () => {
			root.setAttribute("data-theme", newTheme);
		};

		if (animate && document.startViewTransition) {
			document.startViewTransition(update);
		} else {
			update();
		}
	}

	if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
		localStorage.removeItem("theme");
	}

	applyTheme(getUserPref(), false);

	window.addEventListener("pageshow", (e) => {
		if (e.persisted) {
			applyTheme(getUserPref(), false);
		}
	});

	document.addEventListener("theme-change", (e) => {
		const theme = e.detail.theme;
		if (typeof sessionStorage !== "undefined") {
			sessionStorage.setItem("theme-override", theme);
		}
		applyTheme(theme, true);
	});

	const handleSystemThemeChange = (e) => {
		if (typeof sessionStorage !== "undefined") {
			sessionStorage.removeItem("theme-override");
		}
		applyTheme(e.matches ? "dark" : "light", true);
	};

	darkMedia.addEventListener("change", handleSystemThemeChange);
</script>
